# Merge into existing /etc/parcel/parcel.env; retain all current R2/SSD settings.
PARCEL_LISTEN_ADDR=127.0.0.1:8081
PARCEL_BASE_URL=https://parcel.example.com
PARCEL_STORAGE_BACKEND=r2
PARCEL_ADMIN_AUTH=access
PARCEL_GATEWAY_SECRET_FILE=/etc/parcel/gateway.secret
# The client IP is in the verified gateway envelope; no forwarding header trust.
PARCEL_TRUSTED_PROXIES=
# Existing settings must remain: DATA_DIR, REQUIRED_MOUNT, R2_ENDPOINT,
# R2_BUCKET, R2_CREDENTIALS_FILE, quota/TTL limits, etc.
