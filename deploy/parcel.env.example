PARCEL_LISTEN_ADDR=192.168.5.16:8080
PARCEL_BASE_URL=http://192.168.5.16:8080
PARCEL_DATA_DIR=/srv/parcel
# 必须填写数据所在的真实挂载点。当前 Pi 从 SSD 根分区启动，故为 /。
# 如使用独立数据盘，应改成它的挂载点，例如 /mnt/parcel-ssd。
PARCEL_REQUIRED_MOUNT=/
PARCEL_MAX_FILE_BYTES=8589934592
PARCEL_STORAGE_QUOTA_BYTES=21474836480
PARCEL_MIN_FREE_BYTES=2147483648
PARCEL_UPLOAD_CHUNK_BYTES=8388608
PARCEL_UPLOAD_IDLE_TTL=24h
PARCEL_DEFAULT_SHARE_TTL=24h
PARCEL_MAX_SHARE_TTL=168h
PARCEL_DEFAULT_DOWNLOAD_LIMIT=3
PARCEL_DOWNLOAD_IDLE_TTL=30m
PARCEL_DOWNLOAD_MAX_TTL=8h
PARCEL_CLEANUP_INTERVAL=60s
PARCEL_LOG_LEVEL=info
GOMEMLIMIT=192MiB

# New uploads use local storage by default. Existing local files stay local.
PARCEL_STORAGE_BACKEND=local
# To enable R2, set STORAGE_BACKEND=r2 and the following three settings:
# PARCEL_R2_ENDPOINT=https://15cfc46fe23bf82055e97614de76b744.r2.cloudflarestorage.com
# PARCEL_R2_BUCKET=parcel
# PARCEL_R2_CREDENTIALS_FILE=/etc/parcel/r2.credentials
# Credentials file (0600, owned by the service user; never commit):
# ACCESS_KEY_ID=...
# SECRET_ACCESS_KEY=...

# Parcel R2 storage guard: 9 decimal GB; includes staging and reservations.
# This is not an account-wide billing or monthly request limit.
PARCEL_R2_STORAGE_QUOTA_BYTES=9000000000
