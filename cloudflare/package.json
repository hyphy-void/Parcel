{
  "name": "parcel-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler pages dev ../dist/pages --port 8788",
