{
  "name": "parcel-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler pages dev ../dist/pages --port 8788",
    "test:integration": "node --test tests/origin.integration.mjs",
    "test:runtime": "node --test tests/runtime.smoke.mjs",
    "test:browser": "node --test tests/access-ui.browser.mjs",
    "build:v3": "node v3/build.mjs",
    "test:v3": "node --test v3/tests/*.test.mjs",
    "test:browser:v3": "node --test v3/tests/browser.mjs",
    "test:e2ee:https": "node --test v3/tests/e2ee-browser.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "aws4fetch": "^1.0.20",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "wrangler": "^4.149.0"
  }
}
